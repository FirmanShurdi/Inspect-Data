{
  "name": "calokapal-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "prod": "node ./bin/www"
  },
  "nodemonConfig": {
    "watch": ["app.js", "bin/www", "routes", "controller", "model", "controllers", "models", "middleware", "config", "services"],
    "ext": "js,json",
    "legacyWatch": true,
    "ignore": ["node_modules", "public", "uploads", "logs"],
    "delay": 300,
    "events": {
      "restart": "echo 🔄 [RELOAD BACKEND] Perubahan kode backend terdeteksi! Memuat ulang server..."
    }
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "~1.9.1",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "nodemon": "^3.1.14",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
